# Copy to .env and fill in from the Firebase console:
#   Project settings -> Your apps -> Web app -> SDK setup and configuration
#
# These are not secrets. Firebase web config is public by design and is served
# to every browser that loads the page; firestore.rules is what protects data.
# .env keeps one project's ids out of the repository, nothing more.
#
# After editing, run: npm run config
FIREBASE_API_KEY=YOUR_API_KEY
FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
FIREBASE_STORAGE_BUCKET=YOUR_PROJECT.appspot.com
FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
FIREBASE_APP_ID=YOUR_APP_ID
